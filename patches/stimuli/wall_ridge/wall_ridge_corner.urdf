<?xml version="1.0" ?>
<robot name="wall_ridge_corner.urdf">

  <!-- Flat wall surface (180mm plate, covers full ridge length + dome overshoot) -->
  <link name="wall">
    <contact>
      <friction_anchor/>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.025"/>
      </geometry>
      <material name="wall_gray">
        <color rgba="0.7 0.7 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.18 0.18 0.025"/>
      </geometry>
    </collision>
  </link>

  <!-- Ridge along Y axis (horizontal ridge) -->
  <!-- y from -0.08 to 0.0025 = 82.5mm, center at y=-0.03875 -->
  <!-- Long enough that sensor dome (r=16mm) never sees the end -->
  <link name="ridge_h">
    <contact>
      <friction_anchor/>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.005 0.0825 0.005"/>
      </geometry>
      <material name="ridge_red">
        <color rgba="0.7 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.005 0.0825 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Ridge along X axis (vertical ridge) -->
  <!-- x from 0.0025 to 0.08 = 77.5mm, center at x=0.04125 -->
  <link name="ridge_v">
    <contact>
      <friction_anchor/>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0775 0.005 0.005"/>
      </geometry>
      <material name="ridge_red">
        <color rgba="0.7 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.0775 0.005 0.005"/>
      </geometry>
    </collision>
  </link>

  <!-- Both ridges on top of wall, meeting at origin to form L-corner -->
  <!-- Wall top = 0.0125, ridge center z = 0.015 -->

  <!-- Horizontal ridge: y from -0.08 to 0.0025, center at y=-0.03875 -->
  <joint name="ridge_h_joint" type="fixed">
    <origin xyz="0 -0.03875 0.015" rpy="0 0 0"/>
    <parent link="wall"/>
    <child link="ridge_h"/>
  </joint>

  <!-- Vertical ridge: x from 0.0025 to 0.08, center at x=0.04125 -->
  <joint name="ridge_v_joint" type="fixed">
    <origin xyz="0.04125 0 0.015" rpy="0 0 0"/>
    <parent link="wall"/>
    <child link="ridge_v"/>
  </joint>

</robot>
